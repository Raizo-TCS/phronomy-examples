# frozen_string_literal: true

# DX1 and DX2 require this unreleased core revision across all seven bundles.
# A local checkout can be selected explicitly with PHRONOMY_PATH.
phronomy_path = ENV["PHRONOMY_PATH"]

if phronomy_path && !phronomy_path.empty?
  gem "phronomy", path: File.expand_path(phronomy_path, __dir__)
else
  gem "phronomy", git: "https://github.com/Raizo-TCS/phronomy.git",
    ref: "443d42ed44548d70355fb6e3d11a59cdf0618f95"
end
