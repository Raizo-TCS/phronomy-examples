# frozen_string_literal: true

# These examples require the r8 unit 6 core candidate until it is released.
# Select that checkout explicitly with PHRONOMY_PATH; the API preflight rejects older gems.
phronomy_path = ENV["PHRONOMY_PATH"]

if phronomy_path && !phronomy_path.empty?
  gem "phronomy", path: File.expand_path(phronomy_path, __dir__)
else
  gem "phronomy", "~> 0.27.0"
end
