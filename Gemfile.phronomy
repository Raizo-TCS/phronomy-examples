# frozen_string_literal: true

# All example bundles use this reviewed, merged core revision.
# Local development may explicitly select a compatible checkout.
phronomy_path = ENV["PHRONOMY_PATH"]

if phronomy_path && !phronomy_path.empty?
  gem "phronomy", path: File.expand_path(phronomy_path, __dir__)
else
  gem "phronomy", "~> 0.26.0"
end
