# frozen_string_literal: true

# Single source of truth for the Phronomy dependency used by every bundle in
# this repository.
#
# Default: sibling local checkout (../phronomy) — lets examples track phronomy
# main before a release is tagged.  CI replicates this by checking out phronomy
# at that same sibling path via actions/checkout path: ../phronomy.
#
# Override at any time:
#   PHRONOMY_PATH=/absolute/path/to/phronomy bundle install
#
# When a new Phronomy release is published, update the default back to the
# released gem and remove the sibling checkout steps from the CI workflows:
#   gem "phronomy", "~> X.Y.0"
#
# PHRONOMY_PATH is resolved relative to this file, not to the individual
# Rails application's Gemfile.
phronomy_path = ENV.fetch("PHRONOMY_PATH", "../phronomy")

if phronomy_path && !phronomy_path.empty?
  gem "phronomy", path: File.expand_path(phronomy_path, __dir__)
else
  gem "phronomy", "~> 0.20.0"
end
