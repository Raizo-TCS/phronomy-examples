# frozen_string_literal: true

# Single source of truth for the Phronomy dependency used by every bundle in
# this repository.
#
# Default: the reviewed, merged framework commit. The gem version alone does
# not identify the unreleased durable coordination contract used here.
# Local framework development: set PHRONOMY_PATH to a compatible checkout.
#
#   PHRONOMY_PATH=../phronomy bundle install
#
phronomy_path = ENV["PHRONOMY_PATH"]

if phronomy_path && !phronomy_path.empty?
  gem "phronomy", path: File.expand_path(phronomy_path, __dir__)
else
  gem "phronomy", "~> 0.24.0"
end
